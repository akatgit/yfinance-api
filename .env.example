# Copy this file to .env and fill in values for local development.
# python-dotenv loads .env automatically when the server starts.
# Variables already set in the shell take precedence over .env.

# Optional: set an API key to protect your endpoints.
# If set, all requests must include ?api_key=YOUR_KEY
# Leave blank/unset to allow open access.
API_KEY=

# Port (Railway/Heroku inject this automatically; default 8000 locally)
PORT=8000
